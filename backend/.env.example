# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Authentication Configuration
AUTH_JWT_SECRET=your-secret-key-change-in-production
AUTH_ISSUER=fbr-invoice-portal
AUTH_AUDIENCE=fbr-invoice-portal

# FBR API Configuration
FBR_SANDBOX_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di
FBR_PRODUCTION_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
MAX_INVOICE_SIZE=1048576

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000"]
