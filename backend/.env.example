# ============================================
# E-INVOICING PORTAL - ENVIRONMENT VARIABLES
# ============================================
# SECURITY WARNING: NEVER commit actual .env to git!
# ============================================

# DATABASE CONFIGURATION
DATABASE_URL=postgresql://user:password@localhost:5432/fbr_invoices?sslmode=require

# AUTHENTICATION SECRETS
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
AUTH_ISSUER=fbr-invoice-portal
AUTH_AUDIENCE=fbr-invoice-portal

# ENCRYPTION KEY FOR FBR TOKENS
# Generate with: openssl rand -base64 44
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_44

# FBR API CONFIGURATION
FBR_SANDBOX_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di
FBR_PRODUCTION_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di

# AI AGENT CONFIGURATION
ANTHROPIC_API_KEY=your_claude_api_key_here

# APPLICATION SETTINGS
APP_ENV=development
LOG_LEVEL=INFO
MAX_INVOICE_SIZE=1048576
DB_ECHO=false
DRY_RUN=true

# CORS SETTINGS (Production: single domain only!)
ALLOWED_ORIGINS=http://localhost:3000
