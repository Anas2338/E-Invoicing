# Database Configuration - Neon PostgreSQL
# Main database (existing invoices, users, master data)
DATABASE_URL=postgresql://....

# Automation Database (bulk uploads, scheduled invoices)
AUTOMATION_DATABASE_URL=postgresql://....

# Authentication Configuration
AUTH_JWT_SECRET=your-secret-key-here
AUTH_ISSUER=fbr-invoice-portal
AUTH_AUDIENCE=fbr-invoice-portal

# Encryption Key for FBR Tokens
ENCRYPTION_KEY=your-encryption-key-here

# FBR API Configuration
FBR_SANDBOX_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di
FBR_PRODUCTION_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di

# AI Agent Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here

# Transfer Configuration (Pakistan Time - PKT is UTC+5)
# Daily transfer of last 24h validated invoices from automation DB to main DB
# Default: 6 PM PKT (18:00)
TRANSFER_SCHEDULE_HOUR=18
TRANSFER_SCHEDULE_MINUTE=0

# Cleanup Configuration
CLEANUP_SCHEDULE_HOUR=2
CLEANUP_SCHEDULE_MINUTE=0
CLEANUP_RETENTION_DAYS=2
AUTOMATION_LOG_RETENTION_DAYS=90

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
MAX_INVOICE_SIZE=1048576

# Database Logging
DB_ECHO=false

# Dry Run Mode
DRY_RUN=true

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000"]

# Email Configuration (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=E-Invoicing Portal
FRONTEND_URL=http://localhost:3000
