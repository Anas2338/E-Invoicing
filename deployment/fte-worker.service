[Unit]
Description=E-Invoicing FTE Worker - Automated Invoice Processing
After=network.target postgresql.service
Requires=postgresql.service
Documentation=https://github.com/your-org/e-invoicing

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/e-invoicing/backend

# Python virtual environment
Environment="PATH=/var/www/e-invoicing/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/var/www/e-invoicing/backend"

# Load environment variables from .env file
EnvironmentFile=/var/www/e-invoicing/backend/.env

# Start the FTE worker
ExecStart=/var/www/e-invoicing/backend/.venv/bin/python -m src.workers.fte_worker

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Logging
StandardOutput=append:/var/log/fte-worker/output.log
StandardError=append:/var/log/fte-worker/error.log
SyslogIdentifier=fte-worker

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/fte-worker

# Resource limits
LimitNOFILE=65536
MemoryLimit=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
