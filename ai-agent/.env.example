# AI Agent Configuration - EXAMPLE FILE
# Copy this to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================
# SECURITY WARNING
# ============================================
# This is an EXAMPLE file. Your actual .env file should:
# 1. Never be committed to git
# 2. Contain real secrets (not these placeholders)
# 3. Have restricted file permissions (chmod 600 .env)

# Dry Run Mode - Set to "true" to test without posting to real FBR
# Simulates FBR responses (95% success rate) for safe testing
# Set to "false" or remove for production
DRY_RUN=true

# AI Provider: "claude" (production) or "gemini" (development/free)
# Defaults to "gemini" in development, "claude" in production
AI_PROVIDER=gemini

# Database Configuration
# Replace with your actual database connection string
# IMPORTANT: Use ?sslmode=require for encrypted connections
DATABASE_URL=postgresql://....

# Authentication Configuration (Required by backend settings)
# Generate a strong secret (minimum 32 characters):
# openssl rand -base64 48
AUTH_JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Claude API Configuration (Production)
# Get your API key from: https://console.anthropic.com/
# NEVER commit your actual API key!
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Gemini API Configuration (Development/Free)
# Get your free API key from: https://aistudio.google.com/app/apikey
# NEVER commit your actual API key!
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.5-flash

# FBR API Configuration
FBR_SANDBOX_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di
FBR_PRODUCTION_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di
